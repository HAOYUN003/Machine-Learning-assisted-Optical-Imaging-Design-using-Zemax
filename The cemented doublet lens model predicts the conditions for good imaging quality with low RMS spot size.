The cemented doublet lens model predicts the conditions for good imaging quality with low RMS spot size.
import numpy as np
import pandas as pd
import joblib
import warnings

# 屏蔽sklearn特征名警告
warnings.filterwarnings("ignore", message=".*feature names.*", module="sklearn")

# 加载训练好的模型与标准化器
model = joblib.load("doublet_model.pkl")
scaler = joblib.load("doublet_scaler.pkl")

# 随机生成样本数量
N = 1000
results = []

# 循环生成1000组随机透镜参数
for i in range(N):
    # 参数随机范围
    R1 = np.random.uniform(40, 120)
    R2 = np.random.uniform(-120, -30)
    R3 = np.random.uniform(-120, -30)
    R4 = np.random.uniform(40, 150)
    thickness = np.random.uniform(2, 10)

    # 像面扫描区间 30~200mm，步长0.5
    image_positions = np.arange(30, 200.1, 0.5)
    best_rms = 1e10
    best_image = 0

    # 遍历所有像面距离，找到当前透镜最小RMS
    for image_pos in image_positions:
        x = np.array([[
            R1,
            R2,
            R3,
            R4,
            thickness,
            image_pos
        ]])
        x_scaled = scaler.transform(x)
        rms = model.predict(x_scaled)[0]
        # 更新当前组最优像面与最小光斑
        if rms < best_rms:
            best_rms = rms
            best_image = image_pos
    # 保存单组透镜最优结果
    results.append([
        R1, R2, R3, R4,
        thickness,
        best_image,
        best_rms
    ])

# 转为表格
result = pd.DataFrame(
    results,
    columns=[
        "R1",
        "R2",
        "R3",
        "R4",
        "厚度(mm)",
        "最佳像面(mm)",
        "最小RMS(μm)"
    ]
)

# 全局搜寻：全部1000组里RMS最小的最优透镜结构
best = result.loc[result["最小RMS(μm)"].idxmin()]

# 打印全局最优参数
print("=====================================")
print("AI随机优化全局最优结果")
print("=====================================")
print(f"R1 = {best['R1']:.3f}")
print(f"R2 = {best['R2']:.3f}")
print(f"R3 = {best['R3']:.3f}")
print(f"R4 = {best['R4']:.3f}")
print(f"厚度 = {best['厚度(mm)']:.3f} mm")
print(f"最佳像面 = {best['最佳像面(mm)']:.3f} mm")
print(f"预测最小RMS = {best['最小RMS(μm)']:.6f} μm")

# 全部1000组数据保存Excel
result.to_excel(
    "随机优化双胶合透镜.xlsx",
    index=False
)
print("\n文件已保存: 随机优化双胶合透镜.xlsx")
